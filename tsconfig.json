{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@api/*": [
        "./src/api/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@fixtures/*": [
        "./src/fixtures/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@testdata/*": [
        "./src/testdata/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}